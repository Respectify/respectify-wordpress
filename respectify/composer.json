{
    "name": "respectify/respectify-wordpress",
    "description": "Wordpress comment evaluation via the Respectify API",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "respectify/respectify-php": "^0.7.0"
    },
    "autoload": {
        "psr-4": {
            "Respectify\\": "includes/",
            "RespectifyScoper\\Respectify\\": "respectify/respectify-php/src/"
        }
    },
    "require-dev": {
        "humbug/php-scoper": "^0.18.15",
        "sniccowp/php-scoper-wordpress-excludes": "^6.6",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^11"
    }
}
